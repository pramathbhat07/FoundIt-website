{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Item": {
      "title": "Item",
      "description": "Lost or found item",
      "type": "object",
      "properties": {
        "itemName": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "locationFound": { "type": "string" },
        "lastLocation": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string", "enum": ["lost", "found"] },
        "reporterId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["itemName", "type", "reporterId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/items/{itemId}": {
      "schema": "Item",
      "description": "Reported lost and found items"
    }
  }
}
