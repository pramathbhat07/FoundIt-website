rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.reporterId == request.auth.uid) || isAdmin();
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, delete, update: if isAdmin();
    }
  }
}
